{
  "name": "@terjeballestad/bob",
  "version": "0.1.0",
  "description": "Bob: the design system shared by Time Turtle and pm-board",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerjeBallestad/bob.git"
  },
  "files": [
    "dist",
    "README.md",
    "TOKENS.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/bob.css"
  },
  "sideEffects": [
    "*.css",
    "./dist/index.js"
  ],
  "scripts": {
    "build": "vite build && node scripts/inject-css.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
