{
  "name": "@terjeballestad/bob",
  "version": "0.3.0",
  "description": "Bob: the design system shared by Time Turtle and pm-board",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerjeBallestad/bob.git"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "TOKENS.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/bob.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "sideEffects": [
    "*.css",
    "./dist/index.js"
  ],
  "scripts": {
    "build": "vite build && node scripts/inject-css.mjs && node scripts/copy-tailwind.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:visual": "playwright test",
    "test:visual:docker": "docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.65.1-noble sh -c 'npx playwright test \"$@\"' --",
    "test:consumer": "npm run build && scripts/consumer-check.sh"
  },
  "peerDependencies": {
    "@types/react": ">=18.3",
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "http-server": "^14.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
